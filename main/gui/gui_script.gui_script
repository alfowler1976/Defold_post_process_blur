local UI = require("main.modules.UI_helper")

local MSG_BLUR = hash("msg_camera_blur")
local MSG_BLUR_LOW = hash("msg_camera_blur_low")
local MSG_BLUR_HIGH = hash("msg_camera_blur_high")
local MSG_BLUR_ENABLE = hash("msg_camera_blur_enable")

function init(self)

	msg.post(".", "acquire_input_focus")

	self.blur_low = true
	
	-- set up controls
	self.ui_blur_on = UI.new(gui.get_node("blur_on"),false)
	self.ui_blur_off = UI.new(gui.get_node("blur_off"),false)

	self.ui_blur_type = UI.new(gui.get_node("blur_type"),false)

	-- turn on blur processing
	msg.post("@render:", MSG_BLUR_ENABLE, {enable=true})
end

function on_input(self, action_id, action)
	
	if action_id==nil then
		self.ui_blur_on:update_hover(action.x,action.y)
		self.ui_blur_off:update_hover(action.x,action.y)
		self.ui_blur_type:update_hover(action.x,action.y)

	end

	if action_id == hash("touch") and action.pressed then

		-- process blur on
		if self.ui_blur_on:pick(action.x,action.y) then
			pprint("blur-on")
			msg.post("@render:", MSG_BLUR, {value=8,duration=2})
		end

		-- process blur off
		if self.ui_blur_off:pick(action.x,action.y) then
			pprint("blur-off")
			msg.post("@render:", MSG_BLUR, {value=0,duration=2})
		end

		-- process blur type
		if self.ui_blur_type:pick(action.x,action.y) then

			if (self.blur_low==true) then
				self.blur_low = false
				self.ui_blur_type:set_text("<size=50%>Blur type:</size>\nHigh")
				msg.post("@render:", MSG_BLUR_HIGH,nil)
			else
				self.blur_low = true
				self.ui_blur_type:set_text("<size=50%>Blur type:</size>\nLow")
				msg.post("@render:", MSG_BLUR_LOW,nil)
			end
		end
	end
end

